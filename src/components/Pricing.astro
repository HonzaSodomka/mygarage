---
// src/components/Pricing.astro

const categories = [
  {
    id: 'prace',
    title: 'Hodinové práce',
    items: [
      { label: 'Mechanická práce — Škoda, VW, Seat, jiné',                    price: '790 Kč/hod', note: null },
      { label: 'Mechanická práce — BMW, Mercedes-Benz, Porsche',               price: '890 Kč/hod', note: null },
      { label: 'Klempířská práce',                                             price: '950 Kč/hod', note: null },
    ],
  },
  {
    id: 'geometrie',
    title: 'Geometrie kol',
    items: [
      { label: 'Zaměření a seřízení přední nápravy',                          price: '1 300 Kč', note: null },
      { label: 'Zaměření a seřízení přední i zadní — osobní vozy',            price: '2 200 Kč', note: 'vč. zkušební jízdy' },
      { label: 'Zaměření a seřízení přední i zadní — SUV, užitkové',          price: '2 400 Kč', note: 'vč. zkušební jízdy' },
      { label: 'Zaměření a seřízení s použitím sklonoměru',                   price: '2 600 Kč', note: 'vč. zkušební jízdy' },
      { label: 'Uvolnění spojovacích tyček pomocí indukce',                   price: '+ 400 Kč', note: 'příplatek' },
    ],
  },
  {
    id: 'olej',
    title: 'Motorový olej',
    items: [
      { label: 'Výměna oleje (práce)',          price: '590 Kč',   note: null },
      { label: 'Shell Longlife 5W30',           price: '390 Kč/l', note: null },
      { label: 'Shell Longlife 5W30 BMW spec.', price: '390 Kč/l', note: null },
      { label: 'Shell Longlife 5W40',           price: '380 Kč/l', note: null },
    ],
  },
  {
    id: 'pneuservis',
    title: 'Pneuservis',
    items: [
      { label: 'Demontáž, montáž sady kol vč. vyvážení', price: '900 Kč',    note: null },
      { label: 'Vyvážení sady kol',                       price: '600 Kč',    note: null },
      { label: 'Vaky na kola',                            price: '25 Kč/ks',  note: null },
      { label: 'Přezutí 13″–16″',                         price: '1 100 Kč',  note: null },
      { label: 'Přezutí 17″–18″',                         price: '1 300 Kč',  note: null },
      { label: 'Přezutí 19″',                             price: '1 600 Kč',  note: null },
      { label: 'Přezutí 20″',                             price: '2 000 Kč',  note: null },
      { label: 'Přezutí 21″–22″',                         price: '2 200 Kč',  note: null },
      { label: 'Přezutí dodávek 15″–17″',                 price: '2 200 Kč',  note: null },
      { label: 'Oprava průrazu hříbkem (trvalá)',          price: '500 Kč',    note: '+ přezutí dle velikosti' },
      { label: 'Oprava průrazu knotem',                   price: '400 Kč',    note: null },
      { label: 'Ekologická likvidace pneu',               price: '150 Kč/ks', note: null },
    ],
  },
  {
    id: 'priplat',
    title: 'Příplatky pneuservis',
    items: [
      { label: 'Dojezdové pneu RunFlat / RSC',         price: '+ 100 Kč/ks',  note: null },
      { label: 'Ventilky TPMS / ztížená demontáž',     price: '+ 50 Kč/ks',   note: null },
      { label: 'Karbon-keramické brzdové kotouče',      price: '+ 250 Kč/ks',  note: null },
      { label: 'Závaží nad 240 g na 4 ks kol',         price: '+ 80 Kč/60 g', note: null },
      { label: 'Ventilky gumové',                      price: '30 Kč/ks',     note: null },
      { label: 'Ventilky kovové (stříbrné nebo černé)', price: '65 Kč/ks',     note: null },
    ],
  },
  {
    id: 'klima',
    title: 'Klimatizace',
    items: [
      { label: 'Plnění klimatizace (práce)', price: '1 000 Kč', note: null },
      { label: 'Chladivo R134a',            price: '4 Kč/g',   note: null },
      { label: 'Chladivo R1234yf',          price: '8 Kč/g',   note: null },
      { label: 'Dezinfekce výparníku',      price: '550 Kč',   note: null },
    ],
  },
];

const standalone = [
  { label: 'Výměna brzdové kapaliny',                                      price: '1 500 Kč'    },
  { label: 'Diagnostika — načtení a smazání chyb',                         price: '600 Kč'      },
  { label: 'Instalace / registrace autobaterie (diagnostická programace)',  price: 'na dotaz'    },
  { label: 'Zimní kapalina do ostřikovačů',                                price: '150 Kč/l'    },
  { label: 'Chladící kapalina',                                            price: '250 Kč/l'    },
  { label: 'Výměna autoskla / lepení',                                     price: 'od 3 000 Kč' },
  { label: 'Prohlídka vozidla při nákupu vč. diagnostiky',                 price: 'od 2 000 Kč' },
  { label: 'Náhradní vozidlo — nižší střední třída (200 km/den)',          price: '900 Kč/den'  },
];
---

<section id="cenik" class="bg-white">

  <!-- ─── Heading ─── -->
  <div class="max-w-7xl mx-auto px-5 lg:px-12 pt-16 lg:pt-24 pb-10 lg:pb-14 border-b border-zinc-100">
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-20 items-end">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-6 h-px bg-[#E10600]"></div>
          <span style="font-family:'DM Sans',sans-serif;"
                class="text-xs font-medium uppercase tracking-[0.28em] text-zinc-500">Ceník</span>
        </div>
        <h1 style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(2.4rem, 4vw, 4.5rem);"
            class="font-black uppercase leading-[1.05] tracking-tight text-zinc-950">
          Transparentní<br/>
          <span class="text-[#00478F]">ceny prací.</span>
        </h1>
      </div>
      <div class="flex flex-col gap-4 lg:pb-1">
        <div class="w-8 h-px bg-zinc-200"></div>
        <p style="font-family:'DM Sans',sans-serif;"
           class="text-base lg:text-lg font-light text-zinc-700 leading-relaxed">
          Všechny ceny jsou uvedeny <strong class="font-medium text-zinc-900">bez DPH (21 %)</strong>. Nepřijímáme zákazníkem přinesené náhradní díly.
        </p>
        <div class="flex gap-3">
          <a href="/kontakt"
             style="font-family:'DM Sans',sans-serif;"
             class="inline-flex items-center gap-2 self-start bg-[#00478F] hover:bg-[#003d7a] text-white text-xs font-medium uppercase tracking-[0.18em] px-7 py-3 transition-colors relative overflow-hidden group">
            <span class="absolute left-0 inset-y-0 w-[3px] bg-[#E10600]"></span>
            Objednat servis
          </a>
          <a href="https://mygarageautocare.cz/wp-content/uploads/2026/03/CENIK-MG-2026.pdf"
             target="_blank"
             style="font-family:'DM Sans',sans-serif;"
             class="inline-flex items-center gap-2 self-start border border-zinc-300 hover:border-zinc-600 text-zinc-700 text-xs font-medium uppercase tracking-[0.18em] px-5 py-3 transition-colors">
            Stáhnout PDF ↓
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── Obsah ─── -->
  <div class="max-w-7xl mx-auto px-5 lg:px-12 py-12 lg:py-16">

    <div class="flex flex-col">
      {categories.map((cat, ci) => (
        <div class="price-cat border-t border-zinc-200 first:border-t-0">

          <button
            class="price-trigger w-full text-left py-5 lg:py-6 flex items-center gap-4 group"
            aria-expanded="false"
          >
            <!-- Pořadová čísla — dekorativní, záměrně ztlumená -->
            <span style="font-family:'DM Sans',sans-serif;"
                  class="text-xs font-medium text-zinc-300 tabular-nums w-5 flex-shrink-0">
              {String(ci + 1).padStart(2, '0')}
            </span>

            <div class="flex-1 min-w-0">
              <span style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.15rem, 1.8vw, 1.5rem);"
                    class="font-black uppercase tracking-tight leading-none text-zinc-950 group-hover:text-[#00478F] transition-colors">
                {cat.title}
              </span>
            </div>

            <!-- zinc-500 = 4.58:1 ✅ (bylo zinc-400 = 2.57:1 ❌) -->
            <span style="font-family:'DM Sans',sans-serif;"
                  class="hidden lg:block text-xs text-zinc-500 flex-shrink-0">
              {cat.items.length} položek
            </span>

            <div class="price-chevron w-8 h-8 border border-zinc-200 group-hover:border-[#00478F] flex items-center justify-center flex-shrink-0 transition-all duration-200">
              <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-[#00478F] transition-all duration-300" viewBox="0 0 14 14" fill="none">
                <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </button>

          <div class="price-body overflow-hidden" style="max-height: 0; transition: max-height 0.35s ease;">
            <div class="pb-6 pl-9">
              {cat.items.map(item => (
                <div class="flex items-baseline justify-between gap-8 py-3 border-b border-zinc-100 last:border-0">
                  <div class="flex flex-col gap-0.5 flex-1 min-w-0">
                    <span style="font-family:'DM Sans',sans-serif;"
                          class="text-sm lg:text-[15px] text-zinc-700">
                      {item.label}
                    </span>
                    {item.note && (
                      <!-- zinc-500 = 4.58:1 ✅ (bylo zinc-400 = 2.57:1 ❌) -->
                      <span style="font-family:'DM Sans',sans-serif;"
                            class="text-[10px] font-medium uppercase tracking-[0.12em] text-zinc-500">
                        {item.note}
                      </span>
                    )}
                  </div>
                  <span style="font-family:'Big Shoulders Display',sans-serif;"
                        class="text-base lg:text-xl font-black uppercase text-zinc-950 whitespace-nowrap flex-shrink-0">
                    {item.price}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="my-8 flex items-center gap-4">
      <div class="flex-1 h-px bg-zinc-200"></div>
      <!-- zinc-500 = 4.58:1 ✅ (bylo zinc-400 = 2.57:1 ❌) -->
      <span style="font-family:'DM Sans',sans-serif;"
            class="text-[10px] font-medium uppercase tracking-[0.25em] text-zinc-500">
        Ostatní položky
      </span>
      <div class="flex-1 h-px bg-zinc-200"></div>
    </div>

    <div class="flex flex-col">
      {standalone.map(item => (
        <div class="flex items-baseline justify-between gap-8 py-4 border-b border-zinc-100">
          <span style="font-family:'DM Sans',sans-serif;"
                class="text-sm lg:text-[15px] text-zinc-800 flex-1">
            {item.label}
          </span>
          <span style="font-family:'Big Shoulders Display',sans-serif;"
                class="text-base lg:text-xl font-black uppercase text-zinc-950 whitespace-nowrap flex-shrink-0">
            {item.price}
          </span>
        </div>
      ))}
    </div>

    <div class="h-12 lg:h-16"></div>

    <div class="border border-zinc-200 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-[3px] h-full bg-[#E10600]"></div>
      <div class="px-8 lg:px-14 py-10 lg:py-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="flex flex-col gap-2">
          <p style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.4rem, 2.5vw, 2.2rem);"
             class="font-black uppercase text-zinc-950 leading-tight">
            Máte dotaz k cenám?
          </p>
          <p style="font-family:'DM Sans',sans-serif;" class="text-sm text-zinc-500">
            Kontaktujte nás — rádi připravíme konkrétní kalkulaci.
          </p>
        </div>
        <a href="/kontakt" style="font-family:'DM Sans',sans-serif;"
           class="inline-flex items-center gap-2 flex-shrink-0 bg-[#00478F] hover:bg-[#003d7a] text-white text-xs font-medium uppercase tracking-[0.18em] px-7 py-3.5 transition-colors relative overflow-hidden group">
          <span class="absolute left-0 inset-y-0 w-[3px] bg-[#E10600]"></span>
          Kontaktovat nás
          <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 12 12" fill="none">
            <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

  </div>

</section>

<script>
  document.querySelectorAll('.price-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const cat     = btn.closest('.price-cat');
      const body    = cat?.querySelector('.price-body') as HTMLElement | null;
      const chevron = btn.querySelector('.price-chevron svg') as HTMLElement | null;
      const isOpen  = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        if (body) body.style.maxHeight = '0';
        if (chevron) chevron.style.transform = '';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        if (body) {
          body.style.maxHeight = 'none';
          const h = body.scrollHeight;
          body.style.maxHeight = '0';
          requestAnimationFrame(() => { body.style.maxHeight = h + 'px'; });
        }
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>