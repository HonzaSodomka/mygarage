---
// src/components/Packages.astro

const packages = [
  {
    id: '1A', title: 'Základní výměna oleje 5W30', price: '3 900 Kč', tag: null,
    items: ['Olej 5W30 do 5l výměny','Olejový filtr','Výpustný šroub s těsněním','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '1B', title: 'Základní výměna oleje 0W20', price: '4 450 Kč', tag: null,
    items: ['Olej 0W20 do 5l výměny','Olejový filtr','Výpustný šroub s těsněním','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '2', title: 'Servis s filtry', price: '7 600 Kč', tag: null,
    items: ['Olej 5W30 do 5l výměny','Olejový filtr','Vzduchový filtr','Palivový filtr','Kabinový filtr s aktivním uhlíkem','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '3', title: 'Servis + zapalovací svíčky', price: '10 900 Kč', tag: 'Benzin',
    items: ['Olej 5W30 do 5l výměny','Olejový + vzduchový + palivový filtr','Kabinový filtr s aktivním uhlíkem','Zapalovací svíčky 4válec benzin','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '4', title: 'Servis + žhavící svíčky', price: '17 764 Kč', tag: 'Diesel',
    items: ['Olej 5W30 do 5l výměny','Olejový + vzduchový + palivový filtr','Kabinový filtr s aktivním uhlíkem','Žhavící svíčky 3ks + 1ks s čidlem tlaku','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '5', title: 'Servis + brzdová kapalina', price: '9 100 Kč', tag: null,
    items: ['Olej 5W30 do 5l výměny','Olejový + vzduchový + palivový filtr','Kabinový filtr s aktivním uhlíkem','Výměna brzdové kapaliny','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '6', title: 'Servis + brzdová kapalina + diagnostika', price: '9 600 Kč', tag: null,
    items: ['Olej 5W30 do 5l výměny','Olejový + vzduchový + palivový filtr','Kabinový filtr s aktivním uhlíkem','Výměna brzdové kapaliny','Diagnostika — načtení chybových hlášení','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '7', title: 'Komplexní servis s protokolem', price: '11 100 Kč', tag: null,
    items: ['Olej 5W30 do 5l výměny','Olejový + vzduchový + palivový filtr','Kabinový filtr s aktivním uhlíkem','Výměna brzdové kapaliny','Diagnostika + mazání + protokol','Kontrola vozidla s protokolem'],
  },
  {
    id: '8', title: 'Olej + diagnostika', price: '4 400 Kč', tag: null,
    items: ['Olej 5W30 do 5l výměny','Olejový filtr','Výpustný šroub s těsněním','Diagnostika + mazání + protokol','Nastavení servisního intervalu','Vizuální prohlídka vozidla'],
  },
  {
    id: '9', title: 'Geometrie kol', price: '1 990 Kč', tag: null,
    items: ['Zaměření geometrie vozidla','Seřízení geometrie vozidla'],
  },
];
---

<section id="balicky" class="bg-white">

  <!-- ─── Heading ─── -->
  <div class="max-w-7xl mx-auto px-5 lg:px-12 pt-16 lg:pt-24 pb-10 lg:pb-14 border-b border-zinc-100">
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-20 items-end">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-6 h-px bg-[#E10600]"></div>
          <span style="font-family:'DM Sans',sans-serif;"
                class="text-xs font-medium uppercase tracking-[0.28em] text-zinc-500">Balíčky servisu</span>
        </div>
        <h1 style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(2.4rem, 4vw, 4.5rem);"
            class="font-black uppercase leading-[1.05] tracking-tight text-zinc-950">
          Škoda & Volkswagen<br/>
          <span class="text-[#00478F]">servisní balíčky.</span>
        </h1>
      </div>
      <div class="flex flex-col gap-4 lg:pb-1">
        <div class="w-8 h-px bg-zinc-200"></div>
        <p style="font-family:'DM Sans',sans-serif;"
           class="text-base lg:text-lg font-light text-zinc-700 leading-relaxed">
          Připravili jsme přehledné servisní balíčky pro vozy Škoda a Volkswagen. Vyberte si rozsah servisu podle potřeby vašeho vozu.
        </p>
        <!-- flex-wrap + whitespace-nowrap na obou tlačítkách -->
        <div class="flex flex-wrap gap-3">
          <a href="/kontakt"
             style="font-family:'DM Sans',sans-serif;"
             class="inline-flex items-center gap-2 self-start bg-[#00478F] hover:bg-[#003d7a] text-white text-xs font-medium uppercase tracking-[0.18em] px-7 py-3 whitespace-nowrap transition-colors relative overflow-hidden group">
            <span class="absolute left-0 inset-y-0 w-[3px] bg-[#E10600]"></span>
            Objednat servis
          </a>
          <a href="tel:+420790220000"
             style="font-family:'DM Sans',sans-serif;"
             class="inline-flex items-center gap-2 self-start border border-zinc-300 hover:border-zinc-600 text-zinc-700 text-xs font-medium uppercase tracking-[0.18em] px-6 py-3 whitespace-nowrap transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.08-7.074-6.97l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            +420 790 220 000
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── Accordion ─── -->
  <div class="max-w-7xl mx-auto px-5 lg:px-12 py-10 lg:py-16">

    <div id="pkg-list" class="flex flex-col">
      {packages.map((pkg, i) => (
        <div class="pkg-item" data-i={i}>

          <button
            class="pkg-trigger w-full flex items-center gap-4 lg:gap-8 py-5 lg:py-6 border-t border-zinc-100 text-left group"
            aria-expanded="false"
          >
            <span style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.6rem, 2.5vw, 2.2rem);"
                  class="font-black uppercase text-zinc-200 group-hover:text-[#00478F] transition-colors duration-150 w-14 lg:w-20 flex-shrink-0 leading-none tabular-nums">
              {pkg.id}
            </span>

            <div class="flex-1 flex flex-col gap-1.5">
              <span style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.1rem, 1.8vw, 1.5rem);"
                    class="font-black uppercase tracking-tight leading-none text-zinc-950 group-hover:text-[#00478F] transition-colors duration-150">
                {pkg.title}
              </span>
              {pkg.tag && (
                <span style="font-family:'DM Sans',sans-serif;"
                      class="self-start text-[8px] font-bold uppercase tracking-[0.18em] bg-zinc-950 text-white px-2 py-0.5">
                  {pkg.tag}
                </span>
              )}
            </div>

            <span style="font-family:'DM Sans',sans-serif;"
                  class="pkg-count hidden lg:block text-xs font-medium text-zinc-500 flex-shrink-0 transition-opacity duration-200">
              {pkg.items.length} položek
            </span>

            <span style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.1rem, 2vw, 1.6rem);"
                  class="font-black uppercase text-zinc-950 flex-shrink-0 text-right min-w-[100px] lg:min-w-[130px] tabular-nums">
              {pkg.price}
            </span>

            <div class="pkg-chevron w-8 h-8 border border-zinc-200 group-hover:border-[#00478F] flex items-center justify-center flex-shrink-0 transition-all duration-200">
              <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-[#00478F] transition-all duration-300" viewBox="0 0 14 14" fill="none">
                <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </button>

          <div class="pkg-body overflow-hidden" style="max-height:0; transition: max-height 0.4s cubic-bezier(0.4,0,0.2,1);">
            <div class="pb-10 pl-14 lg:pl-28 border-t border-zinc-50 pt-6">

              <div class="grid grid-cols-1 sm:grid-cols-2 max-w-2xl mb-8">
                {pkg.items.map((item) => (
                  <div class="flex items-center gap-3 py-2.5 border-b border-zinc-100">
                    <div class="w-1.5 h-1.5 rounded-full bg-[#00478F] flex-shrink-0"></div>
                    <span style="font-family:'DM Sans',sans-serif;"
                          class="text-sm text-zinc-700">{item}</span>
                  </div>
                ))}
              </div>

              <a href="/kontakt"
                 style="font-family:'DM Sans',sans-serif;"
                 class="inline-flex items-center gap-2 bg-[#00478F] hover:bg-[#003d7a] text-white text-xs font-medium uppercase tracking-[0.18em] px-7 py-3.5 transition-colors relative overflow-hidden group/btn">
                <span class="absolute left-0 inset-y-0 w-[3px] bg-[#E10600]"></span>
                Objednat tento balíček
                <svg class="w-3 h-3 transition-transform duration-200 group-hover/btn:translate-x-1" viewBox="0 0 12 12" fill="none">
                  <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

            </div>
          </div>

        </div>
      ))}

      <div class="border-t border-zinc-100"></div>
    </div>

    <!-- Bottom CTA -->
    <div class="border border-zinc-200 mt-12 lg:mt-16 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-[3px] h-full bg-[#E10600]"></div>
      <div class="px-8 lg:px-14 py-10 lg:py-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="flex flex-col gap-2">
          <p style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.4rem, 2.5vw, 2.2rem);"
             class="font-black uppercase text-zinc-950 leading-tight">
            Potřebujete poradit s výběrem?
          </p>
          <p style="font-family:'DM Sans',sans-serif;" class="text-sm text-zinc-500">
            Ceny s DPH, platí pro vozy do 5l oleje. Dotazy na <a href="tel:+420790220000" class="text-[#00478F] hover:text-[#003d7a] font-medium">+420 790 220 000</a>.
          </p>
        </div>
        <a href="/kontakt" style="font-family:'DM Sans',sans-serif;"
           class="inline-flex items-center gap-2 flex-shrink-0 bg-[#00478F] hover:bg-[#003d7a] text-white text-xs font-medium uppercase tracking-[0.18em] px-7 py-3.5 transition-colors relative overflow-hidden group">
          <span class="absolute left-0 inset-y-0 w-[3px] bg-[#E10600]"></span>
          Kontaktovat nás
          <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 12 12" fill="none">
            <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

  </div>

</section>

<script>
  document.querySelectorAll('.pkg-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item    = btn.closest('.pkg-item');
      const body    = item?.querySelector('.pkg-body') as HTMLElement | null;
      const chevron = btn.querySelector('.pkg-chevron');
      const count   = btn.querySelector('.pkg-count') as HTMLElement | null;
      const isOpen  = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        if (body) body.style.maxHeight = '0';
        const svg = chevron?.querySelector('svg') as HTMLElement | null;
        if (svg) svg.style.transform = '';
        if (count) count.style.opacity = '1';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        if (body) body.style.maxHeight = body.scrollHeight + 'px';
        const svg = chevron?.querySelector('svg') as HTMLElement | null;
        if (svg) svg.style.transform = 'rotate(180deg)';
        if (count) count.style.opacity = '0';
      }
    });
  });
</script>