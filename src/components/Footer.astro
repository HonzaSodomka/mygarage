---
// src/components/Footer.astro

const navItems = [
  { label: 'O nás',    href: '#o-nas'   },
  { label: 'Služby',   href: '#sluzby'  },
  { label: 'Balíčky',  href: '#balicky' },
  { label: 'Ceník',    href: '#cenik'   },
  { label: 'Kontakt',  href: '#kontakt' },
];
---

<footer class="bg-zinc-950 relative z-10 border-t border-white/10" style="font-family:'DM Sans',sans-serif; isolation: isolate; transform: translateZ(0);">

  <!-- Hlavní obsah -->
  <div class="max-w-7xl mx-auto px-5 lg:px-12 py-14 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

      <!-- Logo + popis -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        <a href="/">
          <img src="/logo.png" alt="My Garage Auto Care"
               class="h-10 lg:h-12 w-auto object-contain brightness-0 invert" />
        </a>
        <p class="text-sm font-light text-white/50 leading-relaxed max-w-sm">
          Nezávislý prémiový autoservis zaměřený na BMW, Mercedes-Benz, Porsche a VW koncern. Zázemí autorizovaného servisu — bez dealerské přirážky.
        </p>
        <!-- Sociální sítě -->
        <div class="flex items-center gap-4">
          <a href="https://www.facebook.com/my.garage.auto.care.servis/"
             target="_blank"
             class="flex items-center justify-center w-9 h-9 border border-white/10 hover:border-white/30 text-white/40 hover:text-white transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/mygarageautocare/"
             target="_blank"
             class="flex items-center justify-center w-9 h-9 border border-white/10 hover:border-white/30 text-white/40 hover:text-white transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigace -->
      <div class="flex flex-col gap-4">
        <span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/30">
          Navigace
        </span>
        <nav class="flex flex-col gap-2.5">
          {navItems.map(item => (
            <a href={item.href}
               class="text-sm text-white/60 hover:text-white transition-colors duration-200">
              {item.label}
            </a>
          ))}
          <a href="https://mygarageautocare.cz/obchodni-podminky/"
             target="_blank"
             class="text-sm text-white/60 hover:text-white transition-colors duration-200">
            VOP a GDPR
          </a>
        </nav>
      </div>

      <!-- Kontakt -->
      <div class="flex flex-col gap-4">
        <span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/30">
          Kontakt
        </span>
        <div class="flex flex-col gap-3">
          <a href="tel:+420790220000"
             class="flex items-center gap-2.5 text-sm text-white/60 hover:text-white transition-colors group">
            <svg class="w-3.5 h-3.5 text-[#E10600] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.08-7.074-6.97l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
            </svg>
            +420 790 220 000
          </a>
          <div class="flex items-start gap-2.5 text-sm text-white/60">
            <svg class="w-3.5 h-3.5 text-[#E10600] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
            </svg>
            <span>Královická 326<br/>Zápy, 250 01<br/>Brandýs n. L.</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-white/60">
            <svg class="w-3.5 h-3.5 text-[#E10600] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            Po–Pá: 08:00–16:30
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Spodní lišta -->
  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-5 lg:px-12 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="text-[11px] text-white/25">
        © {new Date().getFullYear()} My Garage Auto Care · IČO: 10719717
      </span>
      <div class="flex items-center gap-1">
        <span class="text-[11px] text-white/25">Vytvořil</span>
        <a href="https://webresent.cz"
           target="_blank"
           class="text-[11px] text-white/40 hover:text-white transition-colors duration-200 font-medium">
          Webresent
        </a>
      </div>
    </div>
  </div>

</footer>