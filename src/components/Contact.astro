---
// src/components/Contact.astro
---

<section id="kontakt" class="bg-white">

  <!-- ─── Heading ─── -->
  <div class="max-w-7xl mx-auto px-5 lg:px-12 pt-16 lg:pt-24 pb-10 lg:pb-14 border-b border-zinc-100">
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-20 items-end">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-6 h-px bg-[#E10600]"></div>
          <span style="font-family:'DM Sans',sans-serif;"
                class="text-xs font-medium uppercase tracking-[0.28em] text-zinc-500">Kontakt</span>
        </div>
        <h1 style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(2.4rem, 4vw, 4.5rem);"
            class="font-black uppercase leading-[1.05] tracking-tight text-zinc-950">
          Objednejte se<br/>
          <span class="text-[#00478F]">ještě dnes.</span>
        </h1>
      </div>
      <div class="flex flex-col gap-4 lg:pb-1">
        <div class="w-8 h-px bg-zinc-200"></div>
        <p style="font-family:'DM Sans',sans-serif;"
           class="text-base lg:text-lg font-light text-zinc-700 leading-relaxed">
          Napište nám, zavolejte nebo přijeďte přímo do servisu. Odpovíme vám co nejdříve.
        </p>
      </div>
    </div>
  </div>

  <!-- ─── Hlavní grid: formulář + info ─── -->
  <div class="grid lg:grid-cols-2 min-h-[600px]">

    <!-- Formulář — bílý -->
    <div class="px-5 lg:px-12 py-12 lg:py-16 max-w-2xl lg:max-w-none w-full mx-auto lg:mx-0 border-b lg:border-b-0 lg:border-r border-zinc-100">

      <form
        id="contact-form"
        class="flex flex-col gap-0"
        novalidate
      >
        <!-- Jméno + telefon -->
        <div class="grid sm:grid-cols-2 gap-0">
          <div class="form-field border-b border-zinc-200 sm:border-r">
            <!-- zinc-500 = 4.58:1 na bílé ✅ (bylo zinc-400 = 2.57:1 ❌) -->
            <label for="name" style="font-family:'DM Sans',sans-serif;"
                   class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-zinc-500 pt-5 px-0 mb-1">
              Jméno a příjmení *
            </label>
            <input
              id="name" name="name" type="text" required
              autocomplete="name"
              placeholder="Jan Novák"
              style="font-family:'DM Sans',sans-serif;"
              class="w-full pb-4 text-base text-zinc-900 placeholder:text-zinc-300 bg-transparent border-none outline-none focus:outline-none"
            />
          </div>
          <div class="form-field border-b border-zinc-200 sm:pl-6">
            <label for="phone" style="font-family:'DM Sans',sans-serif;"
                   class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-zinc-500 pt-5 mb-1">
              Telefon *
            </label>
            <input
              id="phone" name="phone" type="tel" required
              autocomplete="tel"
              placeholder="+420 777 000 000"
              style="font-family:'DM Sans',sans-serif;"
              class="w-full pb-4 text-base text-zinc-900 placeholder:text-zinc-300 bg-transparent border-none outline-none focus:outline-none"
            />
          </div>
        </div>

        <!-- Email -->
        <div class="form-field border-b border-zinc-200">
          <label for="email" style="font-family:'DM Sans',sans-serif;"
                 class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-zinc-500 pt-5 mb-1">
            E-mail
          </label>
          <input
            id="email" name="email" type="email"
            autocomplete="email"
            placeholder="jan@example.cz"
            style="font-family:'DM Sans',sans-serif;"
            class="w-full pb-4 text-base text-zinc-900 placeholder:text-zinc-300 bg-transparent border-none outline-none focus:outline-none"
          />
        </div>

        <!-- Značka + rok výroby -->
        <div class="grid sm:grid-cols-2 gap-0">
          <div class="form-field border-b border-zinc-200 sm:border-r">
            <label for="car" style="font-family:'DM Sans',sans-serif;"
                   class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-zinc-500 pt-5 px-0 mb-1">
              Značka a model
            </label>
            <input
              id="car" name="car" type="text"
              autocomplete="off"
              placeholder="BMW 3 Series"
              style="font-family:'DM Sans',sans-serif;"
              class="w-full pb-4 text-base text-zinc-900 placeholder:text-zinc-300 bg-transparent border-none outline-none focus:outline-none"
            />
          </div>
          <div class="form-field border-b border-zinc-200 sm:pl-6">
            <label for="year" style="font-family:'DM Sans',sans-serif;"
                   class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-zinc-500 pt-5 mb-1">
              Rok výroby
            </label>
            <input
              id="year" name="year" type="text"
              autocomplete="off"
              placeholder="2020"
              style="font-family:'DM Sans',sans-serif;"
              class="w-full pb-4 text-base text-zinc-900 placeholder:text-zinc-300 bg-transparent border-none outline-none focus:outline-none"
            />
          </div>
        </div>

        <!-- Zpráva -->
        <div class="form-field border-b border-zinc-200">
          <label for="message" style="font-family:'DM Sans',sans-serif;"
                 class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-zinc-500 pt-5 mb-1">
            Popis závady / požadavku *
          </label>
          <textarea
            id="message" name="message" required rows="4"
            placeholder="Popište co potřebujete…"
            style="font-family:'DM Sans',sans-serif; resize: none;"
            class="w-full pb-4 text-base text-zinc-900 placeholder:text-zinc-300 bg-transparent border-none outline-none focus:outline-none"
          ></textarea>
        </div>

        <!-- Submit -->
        <div class="pt-8 flex items-center gap-6">
          <button
            id="submit-btn"
            type="submit"
            style="font-family:'DM Sans',sans-serif;"
            class="inline-flex items-center gap-2 bg-[#00478F] hover:bg-[#003d7a] text-white text-xs font-medium uppercase tracking-[0.18em] px-8 py-4 transition-colors relative overflow-hidden group"
          >
            <span class="absolute left-0 inset-y-0 w-[3px] bg-[#E10600]"></span>
            <span id="submit-label">Odeslat zprávu</span>
            <svg id="submit-arrow" class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 12 12" fill="none">
              <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <!-- zinc-500 = 4.58:1 ✅ (bylo zinc-400 = 2.57:1 ❌) -->
          <p style="font-family:'DM Sans',sans-serif;"
             class="text-xs text-zinc-500">
            * Povinné pole
          </p>
        </div>

        <!-- Success / error msg -->
        <div id="form-status" class="hidden mt-6"></div>

      </form>
    </div>

    <!-- Info — tmavý panel (#0d1f3c) -->
    <div class="bg-[#0d1f3c] relative overflow-hidden" style="isolation:isolate;">
      <div class="absolute top-0 left-0 w-[3px] h-full bg-[#E10600]"></div>

      <div class="relative z-10 px-8 lg:px-12 py-12 lg:py-16 flex flex-col gap-10 h-full">

        <div class="flex flex-col gap-7">

          <!-- Telefon -->
          <div class="flex flex-col gap-1.5">
            <span style="font-family:'DM Sans',sans-serif;"
                  class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/55">
              Telefon
            </span>
            <a href="tel:+420790220000"
               style="font-family:'Big Shoulders Display',sans-serif; font-size: clamp(1.8rem, 3vw, 2.6rem);"
               class="font-black uppercase text-white hover:text-[#4a9fd4] transition-colors leading-none">
              +420 790 220 000
            </a>
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-1.5">
            <span style="font-family:'DM Sans',sans-serif;"
                  class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/55">
              E-mail
            </span>
            <a href="mailto:info@mygarageautocare.cz"
               style="font-family:'DM Sans',sans-serif;"
               class="text-base text-white/85 hover:text-white transition-colors">
              info@mygarageautocare.cz
            </a>
          </div>

          <!-- Adresa -->
          <div class="flex flex-col gap-1.5">
            <span style="font-family:'DM Sans',sans-serif;"
                  class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/55">
              Adresa
            </span>
            <a href="https://maps.google.com/?q=Královická+326,+Zápy"
               target="_blank"
               style="font-family:'DM Sans',sans-serif;"
               class="text-base text-white/85 hover:text-white transition-colors leading-relaxed">
              Královická 326<br/>
              250 01 Zápy<br/>
              Brandýs nad Labem
            </a>
          </div>

          <!-- Otevírací doba -->
          <div class="flex flex-col gap-2">
            <span style="font-family:'DM Sans',sans-serif;"
                  class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/55">
              Otevírací doba
            </span>
            <div class="flex flex-col gap-1">
              <div class="flex items-center justify-between gap-8 max-w-xs">
                <span style="font-family:'DM Sans',sans-serif;" class="text-sm text-white/80">Pondělí — pátek</span>
                <span style="font-family:'Big Shoulders Display',sans-serif;" class="text-base font-black uppercase text-white">08:00 — 16:30</span>
              </div>
              <div class="flex items-center justify-between gap-8 max-w-xs">
                <span style="font-family:'DM Sans',sans-serif;" class="text-sm text-white/80">Sobota — neděle</span>
                <span style="font-family:'Big Shoulders Display',sans-serif;" class="text-base font-black uppercase text-white/50">Zavřeno</span>
              </div>
            </div>
          </div>
        </div>

        <div class="h-px bg-white/10"></div>

        <!-- Fakturační info -->
        <div class="flex flex-col gap-2">
          <span style="font-family:'DM Sans',sans-serif;"
                class="text-[10px] font-semibold uppercase tracking-[0.25em] text-white/55">
            Fakturační údaje
          </span>
          <div style="font-family:'DM Sans',sans-serif;" class="text-sm text-white/65 leading-relaxed">
            My Garage Auto Care s.r.o.<br/>
            IČO: 10719717 · DIČ: CZ10719717<br/>
            Plátci DPH
          </div>
        </div>

        <!-- Sociální sítě -->
        <div class="flex items-center gap-3 mt-auto">
          <a href="https://www.facebook.com/my.garage.auto.care.servis/"
             target="_blank"
             class="flex items-center justify-center w-9 h-9 border border-white/10 hover:border-white/40 text-white/55 hover:text-white transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/mygarageautocare/"
             target="_blank"
             class="flex items-center justify-center w-9 h-9 border border-white/10 hover:border-white/40 text-white/55 hover:text-white transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- ─── Mapa ─── -->
  <div class="w-full" style="height: 420px;">
    <iframe
      src="https://maps.google.com/maps?q=50.17595079276414,14.692838659746915&hl=cs&z=16&output=embed"
      width="100%"
      height="100%"
      style="border: 0; filter: grayscale(20%);"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="My Garage Auto Care — mapa"
    ></iframe>
  </div>

</section>

<style>
  .form-field {
    position: relative;
  }
  .form-field::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 2px;
    background: #00478F;
    transition: width 0.3s ease;
  }
  .form-field:focus-within::after {
    width: 100%;
  }
  input, textarea {
    -webkit-appearance: none;
    appearance: none;
  }
  input:focus, textarea:focus {
    outline: none;
    box-shadow: none;
  }
</style>

<script>
  const form   = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const btn    = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const label  = document.getElementById('submit-label');
  const arrow  = document.getElementById('submit-arrow');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status || !btn || !label || !arrow) return;

    btn.disabled = true;
    label.textContent = 'Odesílám…';
    arrow.style.display = 'none';

    await new Promise(resolve => setTimeout(resolve, 1500));

    status.classList.remove('hidden');
    status.innerHTML = `
      <div style="font-family:'DM Sans',sans-serif;" class="flex items-center gap-3 text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 px-5 py-3">
        <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 16 16" fill="none">
          <path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Zpráva odeslána. Ozveme se vám co nejdříve.
      </div>`;
    form.reset();

    btn.disabled = false;
    label.textContent = 'Odeslat zprávu';
    arrow.style.display = '';
  });
</script>